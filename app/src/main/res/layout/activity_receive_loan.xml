<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_gradient_drawable"
    android:layoutDirection="rtl"
    android:padding="16dp">

    <TextView
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="لطفا مبلغ مورد نظر را انتخاب کنید"
        android:textSize="18dp"
        android:textStyle="bold" />

    <!-- First set of radio buttons -->
    <RadioGroup
        android:id="@+id/radioGroup1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/amount"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radio1_option1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۵۰۰,۰۰۰"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radio1_option2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۱,۰۰۰,۰۰۰"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radio1_option3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۵,۰۰۰,۰۰۰"
            android:textSize="20dp" />
    </RadioGroup>

    <TextView
        android:id="@+id/months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/radioGroup1"
        android:text="لطفا مدت زمان بازپرداخت را انتخاب کنید"
        android:textSize="18dp"
        android:textStyle="bold" />

    <!-- Second set of radio buttons -->
    <RadioGroup
        android:id="@+id/radioGroup2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/months"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radio2_option1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۱۲ ماه"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radio2_option2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۲۴ ماه"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radio2_option3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۳۶ ماه"
            android:textSize="20dp" />
    </RadioGroup>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/radioGroup2"
        android:layout_centerHorizontal="true"
        android:text="پیام به کاربر"
        android:textSize="24dp"
        android:visibility="invisible" />

    <!-- Button to get selected values -->
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/message"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/submitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="دریافت وام" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="بازگشت" />
    </LinearLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttons"
        android:layout_centerHorizontal="true"
        android:layout_margin="5dp"
        android:src="@drawable/qr_base" />
</RelativeLayout>
